# ─────────────────────────────────────────────────────────────────────────
#  definedsolution.com — static Astro build on Hostinger (LiteSpeed)
#
#  This file ships inside the build and lands in public_html/main/, the folder
#  Hostinger's Git deploy owns. It only governs that folder. The domain-level
#  rules — www → apex, HTTPS, and mapping definedsolution.com into /main —
#  live in public_html/.htaccess (see deploy/root.htaccess), because
#  public_html also holds the subdomain sites' folders and must not be
#  touched by a deploy.
# ─────────────────────────────────────────────────────────────────────────

Options -Indexes
DirectoryIndex index.html

# LiteSpeed serves error documents without re-running the root rewrite, so
# point at the file's real location.
ErrorDocument 404 /main/404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Hostinger's Git deploy keeps a .git folder here — never serve it.
  RewriteRule (^|/)\.git(/|$) - [F,L]

  # Nobody should see /main/ in an address. This has to live here: a folder
  # with its own rewrite rules does not inherit the root's. THE_REQUEST is the
  # visitor's original request line, so the root's internal rewrite into
  # /main never triggers it.
  RewriteCond %{THE_REQUEST} \s/main(/[^\s?]*)? [NC]
  RewriteRule ^ /%1 [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Pages: always revalidate, so a deploy shows up immediately.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Astro's JS/CSS live in /_astro with content hashes in their names.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Media keep stable names (a replaced photo reuses its filename): a week.
  <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico|mp4|webm|glb)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml model/gltf-binary
</IfModule>

AddType model/gltf-binary .glb
AddType video/mp4 .mp4
