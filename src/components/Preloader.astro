      </svg>
    </div>

    <span class="preloader__meter"><span data-intro-meter></span></span>
  </div>
</div>

<style>
  .preloader {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 300;
    place-items: center;
    background: var(--color-void);
    clip-path: inset(0% 0% 0% 0%);
    will-change: clip-path;
  }

  /* Only ever visible once the motion engine has taken responsibility for
     removing it again. */
  :global(html.js) .preloader {
    display: grid;
  }

  .preloader__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
  }

  /* Both marks are absolutely placed in one box so the swap between them
     cannot shift the meter below by a pixel. The box is sized on the 3D
     framing — the solid needs room to turn without clipping its own edge. */
  .preloader__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(150px, 18vw, 210px);
    aspect-ratio: 1;
  }

  .preloader__canvas,
  .preloader__mark {
    grid-area: 1 / 1;
    /* Neither mark shows until the engine has decided which one is playing. */
    opacity: 0;
  }

  .preloader__canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .preloader__mark {
    color: var(--color-bone);
    width: clamp(52px, 7vw, 76px);
    height: auto;
    overflow: visible;
  }

  .preloader__meter {
    display: block;
    width: clamp(120px, 18vw, 190px);
    height: 1px;
    background: var(--color-line);
    overflow: hidden;
  }

  .preloader__meter > span {
    display: block;
    height: 100%;
    background: var(--color-rose);
    transform: scaleX(0);
    transform-origin: left;
  }
</style>
