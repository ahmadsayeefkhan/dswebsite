---
/**
 * Procedural service visuals.
 *
 * The journey layout gives every service a picture-sized slot. We have no
 * licensed photography for these, and a stock desk-with-laptop shot would say
 * nothing true about the work — so each service gets an abstract diagram of
 * the *kind of work* it is: engineering reads as an interface wired to a
 * stack, MVP as a widening path with milestones, AI as an agent graph, brand
 * as an identity system next to the numbers it moves. Same contract as
 * ProjectVisual.astro (guideline 02 §8).
 *
 * Every visual: dark surface ground, hairline structure, bone shapes — and
 * exactly one rose element. The scarcity rule holds inside the artwork too.
 *
 * ── Depth and life ─────────────────────────────────────────────────────────
 * Each diagram is built in layers, and every layer carries `data-depth` with
 * a `--d` multiplier. ServicesJourney writes `--px/--py` (pointer offset) onto
 * the figure, and the layers translate by `--d` times that, so the drawing
 * parallaxes under the cursor as a real stack of plates would. The grid is
 * the floor (0.4); the furthest-forward object is the ceiling (~1.8).
 *
 * The idle motion is CSS only, scoped here, and it stays in the family the
 * rest of the page already speaks: dash flow along wiring, a slow pulse on
 * the rose element, a chart that draws itself once the step has arrived
 * (`.jstep.is-in`, set by motion.ts). Nothing loops loudly. All of it pauses
 * with `body.is-paused` and collapses under reduced motion.
 *
 * Swapping in a photograph later is one line in ServicesJourney: replace the
 * <ServiceVisual> with an <img>. Nothing in the frame depends on this file.
 */
export type ServiceVisualName = 'engineering' | 'mvp' | 'ai' | 'brand';

interface Props {
  name: ServiceVisualName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;

/* Read through the tokens rather than the raw hexes so the artwork re-grounds
   with the rest of the page in light mode. The fallbacks are the dark values:
   if a var ever fails to resolve, the visual degrades to the palette it
   shipped with, not to black. */
const C = {
  ground: 'var(--color-surface, #141118)',
  panel: 'var(--color-surface-2, #1C1822)',
  panel2: 'var(--color-surface-3, #241F2B)',
  line: 'var(--color-line, #2C2433)',
  lineUp: 'var(--color-line-strong, #3A3243)',
  bone: 'var(--color-bone, #EDEDED)',
  slate: 'var(--color-slate, #9A93A3)',
  dim: 'var(--color-dim, #92899E)',
  rose: 'var(--color-rose, #CB4A68)',
};

const mono = 'IBM Plex Mono, monospace';
---

<svg
  viewBox="0 0 800 500"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="Abstract diagram of this service"
  class={className}
  width="800"
  height="500"
>
  <defs>
    {/* The one light in the picture: a soft plum bloom, upper-left, so the
        panels read as lit from the same side as the rest of the page. */}
    <radialGradient id={`sv-bloom-${name}`} cx="22%" cy="14%" r="70%">
      <stop offset="0" stop-color={C.panel2} stop-opacity="0.9" />
      <stop offset="1" stop-color={C.ground} stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="800" height="500" fill={C.ground} />
  <rect width="800" height="500" fill={`url(#sv-bloom-${name})`} />

  {/* Hairline substrate, shared by every visual — the floor of the stack. */}
  <g data-depth style="--d: 0.4" stroke={C.line} stroke-width="1" opacity="0.55">
    {Array.from({ length: 15 }, (_, i) => <line x1={(i + 1) * 50} y1="0" x2={(i + 1) * 50} y2="500" />)}
    {Array.from({ length: 9 }, (_, i) => <line x1="0" y1={(i + 1) * 50} x2="800" y2={(i + 1) * 50} />)}
  </g>

  {
    /* ── Engineering: an interface, wired to the stack underneath it ──────── */
    name === 'engineering' && (
      <>
        {/* The stack it runs on — behind the window, further from the eye */}
        <g data-depth style="--d: 0.9">
          {['CLIENT', 'API', 'DATA'].map((label, i) => (
            <g>
              <rect x="566" y={104 + i * 78} width="168" height="60" rx="10" fill={C.panel} stroke={C.lineUp} />
              <text x="590" y={140 + i * 78} fill={C.dim} font-family={mono} font-size="13" letter-spacing="2">
                {label}
              </text>
            </g>
          ))}
          <g stroke={C.lineUp} stroke-width="1.5" fill="none">
            <path d="M650 164 L650 182" />
            <path d="M650 242 L650 260" />
          </g>
          {/* Traffic on the wire between window and stack */}
          <path class="sv-flow" d="M480 134 L566 134" stroke={C.slate} stroke-width="1.5" fill="none" />
          {/* The one rose element: the live deployment */}
          <circle class="sv-pulse" cx="716" cy="122" r="6" fill={C.rose} />
        </g>

        {/* Application window — the nearest plate */}
        <g data-depth style="--d: 1.5">
          <rect x="70" y="86" width="410" height="264" rx="12" fill={C.panel} stroke={C.lineUp} />
          <line x1="70" y1="126" x2="480" y2="126" stroke={C.lineUp} />
          <circle cx="94" cy="106" r="4" fill={C.dim} />
          <circle cx="110" cy="106" r="4" fill={C.dim} />
          <circle cx="126" cy="106" r="4" fill={C.dim} />
          <rect x="150" y="100" width="150" height="12" rx="6" fill={C.panel2} />

          {/* Sidebar + content: the shape of an application, not of a page */}
          <rect x="86" y="142" width="86" height="192" rx="8" fill={C.panel2} />
          {[0, 1, 2, 3].map((i) => (
            <rect x="98" y={160 + i * 26} width={56 - i * 6} height="7" rx="3.5" fill={C.dim} opacity="0.75" />
          ))}

          <rect x="188" y="142" width="276" height="96" rx="8" fill={C.panel2} stroke={C.line} />
          <g fill={C.bone} opacity="0.9">
            <rect x="206" y="164" width="128" height="10" rx="5" />
            <rect x="206" y="186" width="196" height="7" rx="3.5" opacity="0.5" />
            <rect x="206" y="202" width="164" height="7" rx="3.5" opacity="0.5" />
          </g>
          <g fill={C.panel} stroke={C.line}>
            <rect x="188" y="252" width="130" height="82" rx="8" />
            <rect x="334" y="252" width="130" height="82" rx="8" />
          </g>
          <path
            class="sv-draw"
            pathLength="1"
            d="M206 316 L236 292 L266 302 L300 272"
            fill="none"
            stroke={C.bone}
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <g fill={C.slate} opacity="0.8">
            <rect x="352" y="272" width="60" height="8" rx="4" />
            <rect x="352" y="292" width="94" height="6" rx="3" />
            <rect x="352" y="306" width="78" height="6" rx="3" />
          </g>
        </g>
      </>
    )
  }

  {
    /* ── MVP: a narrow idea widening into a shipped product ───────────────── */
    name === 'mvp' && (
      <>
        {/* Milestone track — the floor the states stand on */}
        <g data-depth style="--d: 0.7">
          <line x1="70" y1="392" x2="730" y2="392" stroke={C.lineUp} stroke-width="1.5" />
          <line class="sv-track" x1="70" y1="392" x2="730" y2="392" stroke={C.slate} stroke-width="1.5" />
          {[
            { x: 138, label: 'CONSULT' },
            { x: 336, label: 'PROTOTYPE' },
            { x: 534, label: 'PILOT' },
            { x: 706, label: 'LAUNCH' },
          ].map((m, i) => (
            <g>
              <circle
                class={i === 3 ? 'sv-pulse' : undefined}
                cx={m.x}
                cy="392"
                r={i === 3 ? 9 : 7}
                fill={i === 3 ? C.rose : C.panel}
                stroke={i === 3 ? C.rose : C.slate}
                stroke-width="2"
              />
              <text x={m.x} y="428" fill={C.dim} font-family={mono} font-size="12" letter-spacing="1.6" text-anchor="middle">
                {m.label}
              </text>
            </g>
          ))}
          {/* The widening path between the three states */}
          <g stroke={C.lineUp} stroke-width="1.5" fill="none">
            <path d="M206 245 L250 234" />
            <path d="M422 234 L466 223" />
          </g>
        </g>

        {/* 01 — the sketch, furthest back */}
        <g data-depth style="--d: 1">
          <rect x="70" y="150" width="136" height="190" rx="10" fill={C.panel} stroke={C.lineUp} stroke-dasharray="6 6" />
          <g stroke={C.dim} stroke-width="2" fill="none" opacity="0.8">
            <path d="M92 184 L168 184" />
            <path d="M92 206 L150 206" />
            <rect x="92" y="230" width="92" height="56" rx="6" />
            <path d="M92 304 L134 304" />
          </g>
        </g>

        {/* 02 — the clickable prototype */}
        <g data-depth style="--d: 1.3">
          <rect x="250" y="128" width="172" height="212" rx="10" fill={C.panel} stroke={C.lineUp} />
          <rect x="268" y="150" width="136" height="62" rx="6" fill={C.panel2} />
          <g fill={C.slate} opacity="0.85">
            <rect x="268" y="226" width="98" height="8" rx="4" />
            <rect x="268" y="246" width="136" height="6" rx="3" />
            <rect x="268" y="262" width="116" height="6" rx="3" />
          </g>
          <rect x="268" y="290" width="82" height="26" rx="13" fill={C.panel2} stroke={C.lineUp} />
          {/* cursor — the "clickable" part */}
          <path class="sv-bob" d="M334 300 L334 324 L341 317 L346 328 L352 325 L347 314 L356 313 Z" fill={C.bone} />
        </g>

        {/* 03 — the working pilot, nearest */}
        <g data-depth style="--d: 1.7">
          <rect x="466" y="106" width="264" height="234" rx="12" fill={C.panel} stroke={C.lineUp} />
          <line x1="466" y1="146" x2="730" y2="146" stroke={C.lineUp} />
          <rect x="486" y="120" width="86" height="10" rx="5" fill={C.panel2} />
          <rect x="486" y="166" width="110" height="10" rx="5" fill={C.bone} opacity="0.9" />
          <g fill={C.panel2} stroke={C.line}>
            <rect x="486" y="194" width="110" height="62" rx="8" />
            <rect x="610" y="194" width="100" height="62" rx="8" />
            <rect x="486" y="272" width="224" height="46" rx="8" />
          </g>
          <path
            class="sv-draw"
            pathLength="1"
            d="M504 236 L528 216 L552 224 L578 206"
            fill="none"
            stroke={C.bone}
            stroke-width="2"
            stroke-linecap="round"
          />
          <g fill={C.slate} opacity="0.8">
            <rect x="628" y="214" width="64" height="7" rx="3.5" />
            <rect x="628" y="230" width="48" height="7" rx="3.5" />
            <rect x="504" y="288" width="140" height="7" rx="3.5" />
            <rect x="504" y="302" width="96" height="7" rx="3.5" />
          </g>
        </g>
      </>
    )
  }

  {
    /* ── AI: an agent graph, with the model at its centre ─────────────────── */
    name === 'ai' && (
      <>
        {/* Edges first, so every node sits on top of its own wiring. The dash
            flows toward the outputs — data in, decisions out. */}
        <g data-depth style="--d: 0.8" stroke={C.lineUp} stroke-width="1.5" fill="none">
          <path class="sv-flow" d="M150 132 L360 224" />
          <path class="sv-flow sv-flow--2" d="M150 250 L352 246" />
          <path class="sv-flow sv-flow--3" d="M150 368 L360 268" />
          <path class="sv-flow sv-flow--3" d="M440 224 L650 132" />
          <path class="sv-flow" d="M448 246 L650 250" />
          <path class="sv-flow sv-flow--2" d="M440 268 L650 368" />
          <path d="M150 132 L150 250 L150 368" opacity="0.6" />
          <path d="M650 132 L650 250 L650 368" opacity="0.6" />
        </g>

        {/* Inputs and outputs — mid distance */}
        <g data-depth style="--d: 1.1">
          {[
            { y: 132, label: 'DATA' },
            { y: 250, label: 'TOOLS' },
            { y: 368, label: 'INTENT' },
          ].map((n) => (
            <g>
              <rect x="66" y={n.y - 26} width="84" height="52" rx="10" fill={C.panel} stroke={C.lineUp} />
              <text x="108" y={n.y + 5} fill={C.dim} font-family={mono} font-size="12" letter-spacing="1.4" text-anchor="middle">
                {n.label}
              </text>
            </g>
          ))}
          {[
            { y: 132, label: 'COPILOT' },
            { y: 250, label: 'WORKFLOW' },
            { y: 368, label: 'MEDIA' },
          ].map((n) => (
            <g>
              <rect x="650" y={n.y - 26} width="104" height="52" rx="10" fill={C.panel} stroke={C.lineUp} />
              <text x="702" y={n.y + 5} fill={C.dim} font-family={mono} font-size="12" letter-spacing="1.4" text-anchor="middle">
                {n.label}
              </text>
            </g>
          ))}

          {/* Automation ticking along the bottom */}
          <g fill={C.slate} opacity="0.55">
            {Array.from({ length: 18 }, (_, i) => (
              <rect
                class="sv-tick"
                style={`--i: ${i}`}
                x={66 + i * 38}
                y="446"
                width={i % 3 === 0 ? 22 : 12}
                height="6"
                rx="3"
              />
            ))}
          </g>
        </g>

        {/* The agent itself — nearest */}
        <g data-depth style="--d: 1.7">
          <circle cx="400" cy="246" r="86" fill={C.panel} stroke={C.lineUp} />
          <circle class="sv-orbit" cx="400" cy="246" r="86" fill="none" stroke={C.slate} stroke-width="1" stroke-dasharray="4 26" opacity="0.5" />
          <circle cx="400" cy="246" r="58" fill={C.panel2} stroke={C.line} />
          <g stroke={C.slate} stroke-width="1.5" fill="none" opacity="0.7">
            <circle cx="400" cy="246" r="30" />
            <path d="M400 188 L400 216" />
            <path d="M400 276 L400 304" />
            <path d="M342 246 L370 246" />
            <path d="M430 246 L458 246" />
          </g>
          {/* The one rose element: the spark at the core */}
          <path
            class="sv-spark"
            d="M400 218 L409 237 L428 246 L409 255 L400 274 L391 255 L372 246 L391 237 Z"
            fill={C.rose}
          />
        </g>
      </>
    )
  }

  {
    /* ── Brand: an identity system, next to the numbers it moves ──────────── */
    name === 'brand' && (
      <>
        {/* Performance — the further plate */}
        <g data-depth style="--d: 1">
          <rect x="420" y="96" width="310" height="278" rx="12" fill={C.panel} stroke={C.lineUp} />
          <g stroke={C.line}>
            {[0, 1, 2, 3].map((i) => (
              <line x1="446" y1={148 + i * 48} x2="704" y2={148 + i * 48} />
            ))}
          </g>
          {[46, 74, 62, 110, 142, 178].map((h, i) => (
            <rect
              class="sv-bar"
              style={`--i: ${i}`}
              x={452 + i * 42}
              y={340 - h}
              width="26"
              height={h}
              rx="5"
              fill={C.slate}
              opacity={0.45 + i * 0.11}
            />
          ))}
          <path
            class="sv-draw sv-draw--slow"
            pathLength="1"
            d="M465 288 L507 262 L549 272 L591 226 L633 196 L675 164"
            fill="none"
            stroke={C.bone}
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <text x="446" y="130" fill={C.dim} font-family={mono} font-size="12" letter-spacing="2">
            REACH / RETURN
          </text>
        </g>

        {/* Specimen — nearest */}
        <g data-depth style="--d: 1.6">
          <rect x="70" y="96" width="290" height="200" rx="12" fill={C.panel} stroke={C.lineUp} />
          <text
            x="104"
            y="238"
            fill={C.bone}
            font-family="Archivo, Helvetica Neue, sans-serif"
            font-size="126"
            font-weight="700"
            letter-spacing="-6"
          >
            Aa
          </text>
          <text x="104" y="272" fill={C.dim} font-family={mono} font-size="12" letter-spacing="2">
            IDENTITY
          </text>

          {/* Palette — the one rose element is the accent swatch */}
          {[C.bone, C.slate, C.panel2, C.rose, C.lineUp].map((fill, i) => (
            <rect
              class="sv-pop"
              style={`--i: ${i}`}
              x={70 + i * 60}
              y="326"
              width="48"
              height="48"
              rx="8"
              fill={fill}
              stroke={C.lineUp}
            />
          ))}
          <text x="70" y="404" fill={C.dim} font-family={mono} font-size="12" letter-spacing="2">
            PALETTE
          </text>
        </g>
      </>
    )
  }
</svg>

<style>
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── Depth ────────────────────────────────────────────────────────────────
     The figure writes --px/--py in the range -1..1. Each layer moves by its
     own --d times a small distance, so the plates separate under the pointer.
     transform-box keeps the transform origin sane for SVG groups.        */
  [data-depth] {
    transform-box: fill-box;
    transform-origin: center;
    transform: translate(
      calc(var(--px, 0) * var(--d, 1) * 9px),
      calc(var(--py, 0) * var(--d, 1) * 7px)
    );
    transition: transform 700ms var(--ds-ease);
  }

  /* ── Idle life ────────────────────────────────────────────────────────── */

  .sv-pulse {
    animation: sv-pulse 2.8s var(--ds-ease-in-out) infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .sv-flow {
    stroke-dasharray: 3 14;
    animation: sv-flow 2.4s linear infinite;
  }
  .sv-flow--2 {
    animation-duration: 3.1s;
  }
  .sv-flow--3 {
    animation-duration: 2.7s;
    animation-delay: -1.2s;
  }

  .sv-bob {
    transform-box: fill-box;
    transform-origin: center;
    animation: sv-bob 3.4s var(--ds-ease-in-out) infinite;
  }

  .sv-orbit {
    transform-box: fill-box;
    transform-origin: center;
    animation: sv-spin 36s linear infinite;
  }

  .sv-spark {
    transform-box: fill-box;
    transform-origin: center;
    animation: sv-spark 4.2s var(--ds-ease-in-out) infinite;
  }

  .sv-tick {
    animation: sv-tick 3.6s steps(1, end) infinite;
    animation-delay: calc(var(--i, 0) * -0.2s);
  }

  /* ── Arrival, driven by motion.ts adding .is-in to the step ──────────── */

  .sv-draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.3s var(--ds-ease) 0.45s;
  }
  .sv-draw--slow {
    transition-duration: 1.7s;
  }

  .sv-bar {
    transform-box: fill-box;
    transform-origin: bottom;
    transition: transform 0.9s var(--ds-ease) calc(0.35s + var(--i, 0) * 70ms);
  }

  .sv-pop {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.6s var(--ds-ease) calc(0.5s + var(--i, 0) * 60ms);
  }

  .sv-track {
    transform-box: view-box;
    transform-origin: 70px 392px;
    transition: transform 1.6s var(--ds-ease) 0.4s;
  }

  /* Before the step arrives: charts undrawn, bars flat, swatches gone. Gated
     on html.js so a no-script or reduced-motion reader gets the finished
     picture, never an empty chart. */
  :global(html.js .jstep:not(.is-in)) .sv-draw {
    stroke-dashoffset: 1;
  }
  :global(html.js .jstep:not(.is-in)) .sv-bar {
    transform: scaleY(0);
  }
  :global(html.js .jstep:not(.is-in)) .sv-pop {
    transform: scale(0);
  }
  :global(html.js .jstep:not(.is-in)) .sv-track {
    transform: scaleX(0);
  }

  @keyframes sv-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.35);
      opacity: 0.72;
    }
  }
  @keyframes sv-flow {
    to {
      stroke-dashoffset: -34;
    }
  }
  @keyframes sv-bob {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-3px, -4px);
    }
  }
  @keyframes sv-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes sv-spark {
    0%,
    100% {
      transform: rotate(0deg) scale(1);
    }
    50% {
      transform: rotate(45deg) scale(1.12);
    }
  }
  @keyframes sv-tick {
    0% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
    60% {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sv-pulse,
    .sv-flow,
    .sv-bob,
    .sv-orbit,
    .sv-spark,
    .sv-tick {
      animation: none;
    }
    [data-depth] {
      transform: none;
    }
  }
</style>
