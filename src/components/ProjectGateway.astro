</style>

<script>
  import gsap from 'gsap';

  /* The project form, enhanced.
     Without this script the form still works: with a Web3Forms key it posts
     natively (Web3Forms shows its own confirmation page), without one it opens
     the visitor's mail app. With the script we validate in place, send with
     fetch, and open a thank-you popup on success — the visitor never leaves
     the page. */

  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  const MESSAGES: Record<string, (v: string) => string | null> = {
    name: (v) => (v ? null : 'Tell us who we are speaking with.'),
    email: (v) =>
      !v ? 'We need an email to reply to.' : EMAIL.test(v) ? null : 'That email looks incomplete — check it and try again.',
    brief: (v) => (v.length >= 10 ? null : 'Give us a sentence or two about the project.'),
  };

  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  const dhakaTime = new Intl.DateTimeFormat('en-GB', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'Asia/Dhaka',
  });

  /* ── Thank-you popup ───────────────────────────────────────────────────
     showModal() does the accessibility work (inert page, focus trap, Esc).
     GSAP only choreographs: the card rises, the seal draws, the tick lands,
     sparks burst, then the copy settles line by line. Closing plays a short
     exit first, whichever way the visitor dismisses it. */

  function createThanks(onClosed: () => void) {
    const dialog = document.querySelector<HTMLDialogElement>('[data-thanks]');
    if (!dialog) return null;

    const card = dialog.querySelector<HTMLElement>('[data-thanks-card]')!;
    const ring = dialog.querySelector<SVGElement>('[data-thanks-ring]')!;
    const tick = dialog.querySelector<SVGElement>('[data-thanks-tick]')!;
    const aura = dialog.querySelector<HTMLElement>('[data-thanks-aura]')!;
    const sparks = Array.from(dialog.querySelectorAll<HTMLElement>('[data-thanks-spark]'));
    const lines = Array.from(dialog.querySelectorAll<HTMLElement>('[data-thanks-line]'));
    let closing = false;
    let entrance: gsap.core.Timeline | null = null;

    const open = (name: string, email: string) => {
      dialog.querySelector('[data-thanks-name]')!.textContent = name;
      dialog.querySelector('[data-thanks-email]')!.textContent = email;
      dialog.querySelector('[data-thanks-time]')!.textContent = dhakaTime.format(new Date());

      closing = false;
      window.__dsLenis?.stop();
      dialog.showModal();
      if (reduced()) return;

      entrance?.kill();
      entrance = gsap
        .timeline({ defaults: { ease: 'expo.out' } })
        .fromTo(
          card,
          { autoAlpha: 0, y: 40, scale: 0.94, rotationX: 10, transformPerspective: 900 },
          { autoAlpha: 1, y: 0, scale: 1, rotationX: 0, duration: 0.9 },
        )
        .fromTo(
          ring,
          { strokeDashoffset: 1, opacity: 0 },
          { strokeDashoffset: 0, opacity: 1, duration: 0.9, ease: 'power2.inOut' },
          0.15,
        )
        .fromTo(aura, { scale: 0.4, opacity: 0 }, { scale: 1, opacity: 0.8, duration: 1.2 }, 0.2)
        .fromTo(
          tick,
          // Opacity too: a round line cap leaves a dot even at full offset.
          { strokeDashoffset: 1, opacity: 0 },
          { strokeDashoffset: 0, opacity: 1, duration: 0.45, ease: 'power3.out' },
          0.75,
        )
        .fromTo(
          sparks,
          { x: 0, y: 0, scale: 1, opacity: 1 },
          {
            x: (i) => Math.cos((i / sparks.length) * Math.PI * 2 + 0.3) * gsap.utils.random(58, 84),
            y: (i) => Math.sin((i / sparks.length) * Math.PI * 2 + 0.3) * gsap.utils.random(58, 84),
            scale: 0,
            opacity: 0,
            duration: 1.1,
            ease: 'power3.out',
            stagger: 0.012,
            // Stay hidden (CSS) until the burst actually starts.
            immediateRender: false,
          },
          0.9,
        )
        .fromTo(
          lines,
          { autoAlpha: 0, y: 18 },
          { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.07 },
          0.35,
        );
    };

    const finish = () => {
      dialog.close();
      window.__dsLenis?.start();
      onClosed();
    };

    const close = () => {
      if (closing || !dialog.open) return;
      closing = true;
      entrance?.kill();
      if (reduced()) return finish();
      gsap.to(card, {
        autoAlpha: 0,
        y: 18,
        scale: 0.97,
        duration: 0.32,
        ease: 'power2.in',
        onComplete: () => {
          gsap.set([card, ring, tick, ...lines], { clearProps: 'all' });
          finish();
        },
      });
    };

    dialog.querySelectorAll('[data-thanks-close]').forEach((b) => b.addEventListener('click', close));
    // Esc: run the exit animation instead of the browser's instant close.
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    // A click on the backdrop lands on the <dialog> itself, outside the card.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    return { open };
  }

  function initProjectForm() {
    const form = document.querySelector<HTMLFormElement>('[data-project-form]');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    const thanks = createThanks(() => form.querySelector<HTMLElement>('[data-form-title]')?.focus());
    const submit = form.querySelector<HTMLButtonElement>('[data-form-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const alert = form.querySelector<HTMLElement>('[data-form-alert]')!;
    const live = form.dataset.projectForm === 'live';

    const field = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;

    const check = (name: string) => {
      const input = field(name);
      const out = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (!input || !out) return true;
      const message = MESSAGES[name](input.value.trim());
      input.setAttribute('aria-invalid', String(Boolean(message)));
      out.textContent = message ?? '';
      out.hidden = !message;
      return !message;
    };

    /* Errors appear on submit, then clear as soon as the visitor fixes them —
       never shouted at someone who has only just tabbed into a field. */
    for (const name of Object.keys(MESSAGES)) {
      field(name)?.addEventListener('input', () => {
        if (field(name)?.getAttribute('aria-invalid') === 'true') check(name);
      });
    }

    const setBusy = (busy: boolean) => {
      submit.disabled = busy;
      submit.setAttribute('aria-busy', String(busy));
      label.textContent = busy ? 'Sending…' : 'Initiate project';
    };

    form.addEventListener('submit', async (event) => {
      const results = Object.keys(MESSAGES).map(check);
      if (results.includes(false)) {
        event.preventDefault();
        const firstBad = form.querySelector<HTMLElement>('[aria-invalid="true"]');
        firstBad?.focus();
        return;
      }

      // No key: let the browser hand the brief to the visitor's mail app.
      if (!live) return;

      event.preventDefault();
      alert.hidden = true;
      setBusy(true);

      const data = new FormData(form);
      const budget = form.querySelector<HTMLSelectElement>('#budget');
      const payload: Record<string, string | boolean> = {};
      for (const [key, value] of data.entries()) {
        if (key === 'services') continue;
        payload[key] = String(value);
      }
      payload.services = data.getAll('services').map(String).join(', ') || 'Not specified';
      payload.budget = budget?.value ? budget.selectedOptions[0].text : 'Not specified';
      payload.botcheck = data.has('botcheck');
      if (!payload.company) payload.company = 'Not specified';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.success) throw new Error(result.message || response.statusText);

        form.reset();
        setBusy(false);
        thanks?.open(String(payload.name).split(' ')[0], String(payload.email));
      } catch (error) {
        console.warn('[project-form] send failed:', error);
        alert.hidden = false;
      } finally {
        setBusy(false);
      }
    });
  }

  initProjectForm();
  document.addEventListener('astro:after-swap', initProjectForm);
</script>
