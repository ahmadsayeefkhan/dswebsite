---
import Icon from './Icon.astro';
import { contact, forms, proprietor } from '../data/site';
import { budgetBands, serviceChips } from '../data/content';

/* With a Web3Forms key the form posts there — natively without JS (Web3Forms
   shows its own confirmation page), or via fetch with an in-place thank-you
   when the script runs. Without a key it keeps the old mailto: behaviour. */
const live = forms.web3formsKey !== '';

const contactRows = [
  { icon: 'map-pin' as const, label: 'Studio', value: `${contact.address.street}, ${contact.address.area}`, href: contact.address.maps },
  { icon: 'mail' as const, label: 'Email', value: contact.email, href: `mailto:${contact.email}` },
  { icon: 'phone' as const, label: 'Phone', value: contact.phonePrimary.display, href: `tel:${contact.phonePrimary.href}` },
  { icon: 'message-circle' as const, label: 'WhatsApp', value: contact.whatsapp.display, href: contact.whatsapp.href },
];
---

<section class="section--lg gateway" id="contact">
  <div class="shell">
    <p class="meta gateway__eyebrow" data-reveal="fade">
      <span class="meta__counter">06</span>
      <span class="meta__slash" aria-hidden="true">/</span>
      Initiate project
    </p>

    <div class="gateway__grid">
      {/* ── Left: trust and authority ─────────────────────────────────── */}
      <div class="gateway__trust">
        <h2 class="gateway__headline wdth-h2" data-reveal="lines">
          Let us engineer your next big move<span class="period">.</span>
        </h2>

        <p class="gateway__lead" data-reveal="fade">
          Skip the automated replies. Tell us what you are building, where you are stuck, or what
          you want to scale.
        </p>

        <figure class="quote" data-reveal="fade">
          <blockquote class="quote__text">
            <span class="quote__mark" aria-hidden="true">&ldquo;</span>{proprietor.quote}
          </blockquote>
          <p class="quote__commitment">{proprietor.commitment}</p>
          <figcaption class="quote__by">
            <picture>
              <source srcset={`${proprietor.avatar}.webp`} type="image/webp" />
              <img
                src={`${proprietor.avatar}.jpg`}
                alt={`${proprietor.name}, ${proprietor.role} of Defined Solution`}
                width="320"
                height="320"
                loading="lazy"
                decoding="async"
                class="quote__avatar"
              />
            </picture>
            <span class="quote__id">
              <span class="quote__name">{proprietor.name}</span>
              <span class="quote__role">{proprietor.role}, Defined Solution</span>
            </span>
          </figcaption>
        </figure>

        <dl class="contacts" data-reveal="stagger">
          {
            contactRows.map((row) => (
              <div class="contacts__row">
                <dt class="contacts__label">
                  <Icon name={row.icon} size={15} />
                  <span>{row.label}</span>
                </dt>
                <dd class="contacts__value">
                  {row.href ? (
                    <a href={row.href} class="contacts__link" rel="noopener">
                      {row.value}
                    </a>
                  ) : (
                    row.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      {/* ── Right: the smart form ─────────────────────────────────────── */}
      <div class="gateway__form-wrap" data-reveal="fade">
        <form
          class="form"
          method="post"
          action={live ? forms.endpoint : `mailto:${contact.email}`}
          enctype={live ? undefined : 'text/plain'}
          data-project-form={live ? 'live' : 'mailto'}
          novalidate
        >
          <h3 class="form__title" tabindex="-1" data-form-title>Tell us about the vision</h3>

          {
            live && (
              <>
                <input type="hidden" name="access_key" value={forms.web3formsKey} />
                <input type="hidden" name="subject" value={forms.subject} />
                <input type="hidden" name="from_name" value="Defined Solution website" />
                {/* Honeypot: hidden from people and assistive tech, filled by
                    bots. Web3Forms drops any submission where it is checked. */}
                <input
                  type="checkbox"
                  name="botcheck"
                  class="form__trap"
                  tabindex="-1"
                  autocomplete="off"
                  aria-hidden="true"
                />
              </>
            )
          }

          <div class="form__row">
            <div class="field">
              <label class="field__label" for="name">Full name</label>
              <input
                class="input"
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                required
                aria-describedby="name-error"
              />
              <p class="field__error" id="name-error" data-error-for="name" hidden></p>
            </div>
            <div class="field">
              <label class="field__label" for="email">Work email</label>
              <input
                class="input"
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
                aria-describedby="email-error"
              />
              <p class="field__error" id="email-error" data-error-for="email" hidden></p>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="company">Company or start-up name</label>
            <input
              class="input"
              type="text"
              id="company"
              name="company"
              autocomplete="organization"
            />
          </div>

          <fieldset class="field fieldset">
            <legend class="field__label">What do you need?</legend>
            <div class="chips">
              {
                serviceChips.map((chip) => (
                  <label class="chip">
                    <input type="checkbox" name="services" value={chip} />
                    <span class="chip__dot" aria-hidden="true" />
                    <span>{chip}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="field">
            <label class="field__label" for="budget">Investment scale</label>
            <div class="select-wrap">
              <select class="input" id="budget" name="budget">
                <option value="">Select a range</option>
                {budgetBands.map((band) => <option value={band.value}>{band.label}</option>)}
              </select>
              <Icon name="arrow-right" size={15} class="select-wrap__caret" />
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="brief">The brief</label>
            <textarea
              class="input"
              id="brief"
              name="brief"
              placeholder="Tell us what you are trying to achieve…"
              required
              aria-describedby="brief-error"></textarea>
            <p class="field__error" id="brief-error" data-error-for="brief" hidden></p>
          </div>

          <button
            type="submit"
            class="btn btn--primary btn--lg form__submit"
            data-magnetic="0.16"
            data-form-submit
          >
            <span data-submit-label>Initiate project</span>
            <span class="form__spinner" aria-hidden="true"></span>
            <Icon name="arrow-up-right" size={17} class="btn__icon" />
          </button>

          <div class="form__alert" role="alert" data-form-alert hidden>
            <p>
              Your message didn't send. Check your connection and try again, or reach us directly at
              <a href={`mailto:${contact.email}`}>{contact.email}</a> or on
              <a href={contact.whatsapp.href} target="_blank" rel="noopener">WhatsApp</a>.
            </p>
          </div>

          <ul class="assurances">
            <li>
              <Icon name="clock" size={14} />
              Expect a strategic response within 24 hours
            </li>
            <li>
              <Icon name="shield-check" size={14} />
              Happy to sign a mutual NDA on request
            </li>
          </ul>
        </form>
      </div>
    </div>
  </div>

  {/* ── Thank-you popup ───────────────────────────────────────────────────
      Opens only after Web3Forms confirms the send. A native <dialog> for the
      free parts — inert page behind it, Esc to close, focus kept inside — with
      the entrance choreographed in the script below. Its resting state is the
      finished one, so reduced motion simply shows it. */}
  <dialog class="thanks" data-thanks aria-labelledby="thanks-title" aria-describedby="thanks-lead">
    <div class="thanks__card" data-thanks-card>
      <button type="button" class="thanks__close" data-thanks-close aria-label="Close">
        <Icon name="plus" size={18} />
      </button>

      <div class="thanks__emblem" data-thanks-emblem aria-hidden="true">
        <span class="thanks__aura" data-thanks-aura></span>
        <svg class="thanks__seal" viewBox="0 0 96 96" width="96" height="96">
          <circle class="thanks__track" cx="48" cy="48" r="44" />
          <circle class="thanks__ring" cx="48" cy="48" r="44" pathLength="1" data-thanks-ring />
          <path class="thanks__tick" d="M31 49.5 42 60.5 65 35.5" pathLength="1" data-thanks-tick />
        </svg>
        <span class="thanks__sparks">
          {Array.from({ length: 10 }, () => <span class="thanks__spark" data-thanks-spark />)}
        </span>
      </div>

      <p class="thanks__eyebrow" data-thanks-line>
        Request received <span aria-hidden="true">·</span> <time data-thanks-time></time> Dhaka
      </p>

      <h2 class="thanks__title" id="thanks-title" data-thanks-line>
        Thank you, <span data-thanks-name>friend</span><span class="thanks__period">.</span>
      </h2>

      <p class="thanks__lead" id="thanks-lead" data-thanks-line>
        Your brief is with our team. {proprietor.name.split(' ')[0]} reviews every new request
        personally, and you will hear back at <strong data-thanks-email>your inbox</strong> within
        24 hours.
      </p>

      <ol class="thanks__steps" aria-label="What happens next">
        <li data-thanks-line>
          <span class="thanks__n">01</span>
          <span class="thanks__step"><b>We read your brief</b><small>Today</small></span>
        </li>
        <li data-thanks-line>
          <span class="thanks__n">02</span>
          <span class="thanks__step"><b>Reply in your inbox</b><small>Within 24 hours</small></span>
        </li>
        <li data-thanks-line>
          <span class="thanks__n">03</span>
          <span class="thanks__step"><b>Discovery call</b><small>If we are the right fit</small></span>
        </li>
      </ol>

      <div class="thanks__actions" data-thanks-line>
        <button type="button" class="btn btn--primary" data-thanks-close>Back to the site</button>
        <a class="btn btn--secondary" href={contact.whatsapp.href} target="_blank" rel="noopener">
          Message us on WhatsApp
          <Icon name="arrow-up-right" size={15} class="btn__icon" />
        </a>
      </div>
    </div>
  </dialog>
</section>

<style>
  .gateway {
    position: relative;
    border-top: 1px solid var(--color-line);
    background:
      radial-gradient(90% 60% at 85% 0%, var(--ds-aura-soft) 0%, transparent 60%),
      var(--color-void);
  }

  .gateway__eyebrow {
    margin-bottom: clamp(32px, 4vw, 52px);
  }

  .gateway__grid {
    display: grid;
    gap: clamp(44px, 5vw, 80px);
    align-items: start;
  }

  /* Grid items default to min-width:auto, so one long unbreakable string (the
     email address) could push the whole column past a 320px screen. */
  .gateway__grid > * {
    min-width: 0;
  }

  .gateway__headline {
    font-size: var(--text-h2);
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 15ch;
  }

  .gateway__lead {
    margin-top: 20px;
    max-width: 44ch;
    font-size: var(--text-lead);
    line-height: 1.62;
    color: var(--color-slate);
  }

  /* ── Founder quote ─────────────────────────────────────────────────── */

  .quote {
    margin: clamp(32px, 4vw, 44px) 0 0;
    padding: clamp(22px, 2.6vw, 30px);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-left: 2px solid var(--color-rose);
    border-radius: var(--radius-lg);
  }

  .quote__text {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 106;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--color-bone);
    text-wrap: pretty;
  }

  .quote__mark {
    color: var(--color-rose);
    margin-right: 1px;
  }

  .quote__commitment {
    margin-top: 12px;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-slate);
  }

  .quote__by {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--color-line);
  }

  .quote__avatar {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid var(--color-line-strong);
  }

  .quote__id {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .quote__name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-bone);
  }

  .quote__role {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-dim);
  }

  /* ── Contact rows ─────────────────────────────────────────────────────── */

  .contacts {
    margin: clamp(28px, 3vw, 36px) 0 0;
    border-top: 1px solid var(--color-line);
  }

  .contacts__row {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 16px;
    align-items: baseline;
    padding-block: 13px;
    border-bottom: 1px solid var(--color-line);
  }

  /* Small phones: label above value, so the value gets the full width. */
  @media (max-width: 379px) {
    .contacts__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
  }

  .contacts__label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-dim);
  }

  .contacts__value {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: var(--text-small);
    color: var(--color-slate);
  }

  .contacts__link {
    color: var(--color-bone);
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 3px;
    transition:
      text-decoration-color var(--ds-dur-fast) var(--ds-ease),
      text-underline-offset var(--ds-dur-fast) var(--ds-ease);
  }

  .contacts__link:hover {
    text-decoration-color: var(--color-rose);
    text-underline-offset: 5px;
  }

  /* ── Form ─────────────────────────────────────────────────────────────── */

  .form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: clamp(24px, 3vw, 40px);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  .form__title {
    font-size: var(--text-h3);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-bone);
  }

  .form__row {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 520px) {
    .form__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .field__label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-dim);
    padding: 0;
  }

  .fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .select-wrap {
    position: relative;
  }

  /* :global() — the caret is a child component's root <svg>, outside this
     component's style scope. */
  .select-wrap :global(.select-wrap__caret) {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    color: var(--color-dim);
    pointer-events: none;
  }

  .form__submit {
    margin-top: 4px;
    width: 100%;
  }

  /* `.form` sets display:flex, which would otherwise beat the UA's [hidden]. */
  .form[hidden],
  .field__error[hidden],
  .form__alert[hidden] {
    display: none;
  }

  .form__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* ── Validation ───────────────────────────────────────────────────────── */

  .field__error {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-rose-text);
  }

  .field__error::before {
    content: '— ';
  }

  .form :global(.input[aria-invalid='true']) {
    border-color: var(--color-rose);
  }

  .form__alert {
    padding: 14px 16px;
    border: 1px solid var(--color-rose);
    border-radius: var(--radius-md);
    background: var(--ds-rose-veil);
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-bone);
  }

  .form__alert a {
    color: var(--color-bone);
    text-decoration: underline;
    text-decoration-color: var(--color-rose);
    text-underline-offset: 3px;
  }

  /* ── Sending ──────────────────────────────────────────────────────────── */

  .form__spinner {
    display: none;
    width: 15px;
    height: 15px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 999px;
    animation: form-spin 700ms linear infinite;
  }

  .form__submit[aria-busy='true'] {
    cursor: progress;
    opacity: 0.85;
  }
  .form__submit[aria-busy='true'] .form__spinner {
    display: inline-block;
  }
  .form__submit[aria-busy='true'] :global(.btn__icon) {
    display: none;
  }

  @keyframes form-spin {
    to {
      rotate: 1turn;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .form__spinner {
      animation-duration: 2.4s;
    }
  }

  /* ── Thank-you popup ───────────────────────────────────────────────────── */

  .thanks {
    width: min(100% - 32px, 620px);
    max-width: none;
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-bone);
    overflow: visible;
    cursor: default;
  }

  .thanks::backdrop {
    background: rgb(8 6 10 / 0.72);
    backdrop-filter: blur(10px) saturate(0.8);
    opacity: 1;
    transition:
      opacity 420ms var(--ds-ease),
      overlay 420ms allow-discrete,
      display 420ms allow-discrete;
  }

  @starting-style {
    .thanks[open]::backdrop {
      opacity: 0;
    }
  }

  :global(html[data-theme='light']) .thanks::backdrop {
    background: rgb(25 20 32 / 0.38);
  }

  /* The page's own cursor lives below the top layer, so inside the popup the
     native one comes back and the custom one steps out of the way. */
  .thanks button,
  .thanks a {
    cursor: pointer;
  }
  :global(html:has(.thanks[open])) {
    overflow: hidden;
  }
  :global(html:has(.thanks[open]) .cursor) {
    opacity: 0 !important;
  }

  .thanks__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    max-height: calc(100dvh - 32px);
    overflow: auto;
    padding: clamp(32px, 5vw, 52px) clamp(22px, 4.5vw, 48px) clamp(26px, 4vw, 40px);
    text-align: center;
    background:
      radial-gradient(120% 70% at 50% 0%, var(--ds-rose-veil) 0%, transparent 62%),
      var(--color-surface);
    border: 1px solid var(--color-line-strong);
    border-radius: calc(var(--radius-lg) + 6px);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.04) inset,
      0 40px 120px -30px rgb(0 0 0 / 0.75);
    transform-origin: 50% 60%;
  }

  /* A hairline of light along the top edge — the card's one flourish. */
  .thanks__card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 18%;
    right: 18%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-rose), transparent);
  }

  :global(html[data-theme='light']) .thanks__card {
    box-shadow: 0 40px 100px -30px rgb(25 20 32 / 0.35);
  }

  .thanks__close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-slate);
    transition:
      color var(--ds-dur-fast) var(--ds-ease),
      border-color var(--ds-dur-fast) var(--ds-ease),
      rotate var(--ds-dur) var(--ds-ease);
  }
  .thanks__close :global(svg) {
    rotate: 45deg;
  }
  .thanks__close:hover {
    color: var(--color-bone);
    border-color: var(--color-line-strong);
    rotate: 90deg;
  }
  .thanks__close:focus-visible {
    outline: 2px solid var(--color-rose);
    outline-offset: 2px;
  }

  /* Emblem: a seal that draws itself, a tick, and a short burst of sparks. */
  .thanks__emblem {
    position: relative;
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    margin-bottom: 6px;
  }

  .thanks__aura {
    position: absolute;
    inset: -28px;
    border-radius: 999px;
    background: radial-gradient(circle, var(--ds-rose-glow) 0%, transparent 65%);
    opacity: 0.8;
    pointer-events: none;
  }

  .thanks__seal {
    position: relative;
    display: block;
    overflow: visible;
    rotate: -90deg;
  }

  .thanks__track {
    fill: var(--ds-rose-veil);
    stroke: var(--color-line-strong);
    stroke-width: 1;
  }

  .thanks__ring,
  .thanks__tick {
    fill: none;
    stroke: var(--color-rose);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .thanks__ring {
    stroke-width: 2;
  }
  .thanks__tick {
    stroke: var(--color-bone);
    stroke-width: 3.5;
    rotate: 90deg;
    transform-origin: 48px 48px;
  }

  .thanks__sparks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .thanks__spark {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 5px;
    height: 5px;
    margin: -2.5px 0 0 -2.5px;
    border-radius: 999px;
    background: var(--color-rose);
    opacity: 0;
  }
  .thanks__spark:nth-child(3n) {
    background: var(--color-bone);
    width: 3px;
    height: 3px;
    margin: -1.5px 0 0 -1.5px;
  }

  .thanks__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-rose-text);
    font-variant-numeric: tabular-nums;
  }
  .thanks__eyebrow span {
    color: var(--color-dim);
    margin-inline: 4px;
  }

  .thanks__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 112;
    font-size: clamp(2rem, 5.4vw, 3rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--color-bone);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .thanks__period {
    color: var(--color-rose);
  }

  .thanks__lead {
    max-width: 44ch;
    font-size: var(--text-body);
    line-height: 1.68;
    color: var(--color-slate);
  }
  .thanks__lead strong {
    color: var(--color-bone);
    font-weight: 600;
    overflow-wrap: anywhere;
