    gap: 3px;
  }
  .thanks__step b {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-bone);
  }
  .thanks__step small {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-dim);
  }

  @media (min-width: 560px) {
    .thanks__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .thanks__steps li {
      flex-direction: column;
      gap: 10px;
      padding: 16px 14px 16px 0;
    }
    .thanks__steps li + li {
