  .thanks__steps {
    display: grid;
    gap: 0;
    width: 100%;
    margin: 8px 0 4px;
    padding: 0;
    list-style: none;
    text-align: left;
    border-block: 1px solid var(--color-line);
  }

  .thanks__steps li {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding-block: 14px;
  }
  .thanks__steps li + li {
    border-top: 1px solid var(--color-line);
  }

  .thanks__n {
    font-family: var(--font-mono);
    font-size: 0.625rem;
