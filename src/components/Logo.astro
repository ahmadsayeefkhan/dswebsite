---
/**
 * The Defined Solution mark.
 *
 * One unbroken stroke — the D and the S are a single closed contour, which is
 * why the path below has no subpaths. The period is a true <circle>, so it
 * stays mathematically round at any size instead of inheriting trace error.
 *
 * Stroke inherits `currentColor`. The period is always Signal Rose unless
 * `mono` is set — guideline 04 §4.
 */
interface Props {
  /** Rendered height in px. Two-colour minimum is 24px (guideline 04 §3). */
  size?: number;
  /** Single-colour reproduction: the period inherits currentColor too. */
  mono?: boolean;
  class?: string;
}

const { size = 28, mono = false, class: className = '' } = Astro.props;

// viewBox 0 0 61 87 — aspect ratio 1 : 1.426, portrait. Never force to square.
const width = Math.round((size * 61) / 87);
---

<svg
  width={width}
  height={size}
  viewBox="0 0 61 87"
  fill="none"
  role="img"
  aria-label="Defined Solution"
  class={className}
>
