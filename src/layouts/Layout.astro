---
import '../styles/global.css';
import { company, contact, proprietor, social } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (the 404). */
  noindex?: boolean;
}

const {
  title = `${company.name} — ${company.tagline}`,
  description = company.description,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? company.url).href;
const ogImage = new URL('/brand/og-image.png', Astro.site ?? company.url).href;

const fontHref =
  'https://fonts.googleapis.com/css2' +
  '?family=Archivo:wdth,wght@75..125,400..700' +
  '&family=Instrument+Sans:wght@400..700' +
  '&family=IBM+Plex+Mono:wght@400;500' +
  '&display=swap';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: company.name,
  legalName: company.legalName,
  url: company.url,
  logo: new URL('/brand/icon-512.png', company.url).href,
  image: new URL('/brand/og-image.png', company.url).href,
  description: company.description,
  email: contact.email,
  telephone: contact.phonePrimary.display,
  founder: { '@type': 'Person', name: proprietor.name, jobTitle: proprietor.role },
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address.street,
    addressLocality: 'Dhaka',
    addressRegion: 'Dhaka',
    addressCountry: 'BD',
  },
  sameAs: social.map((s) => s.href),
  areaServed: 'Worldwide',
  knowsAbout: [
    'Web application engineering',
    'MVP product strategy',
    'AI automation and agent workflows',
    'Brand and digital marketing',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    {/* Root-level icons, where browsers and search engines look by default.
        The ?v= query forces a refetch: the previous site used these same
        paths, and browsers cache favicons far longer than their headers say.
        Bump it whenever the mark changes. */}
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <meta name="theme-color" content="#0B090E" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="geo.region" content="BD-13" />
    <meta name="geo.placename" content="Dhaka" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    {/*
      Theme, resolved before first paint.

      This has to be inline and synchronous in <head>: any deferred or bundled
      script runs after the first paint, so a reader who chose light would get
      a black flash on every navigation. Stored choice wins; otherwise follow
      the OS. The control that writes the choice lives in the navbar.
    */}
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('ds-theme');
        } catch (e) {
          /* Storage blocked — fall through to the OS preference. */
        }
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
        if (theme === 'light') {
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#F6F4F8');
        }
      })();
    </script>

    {/*
      Progressive-enhancement gate. `html.js` switches on the initial hidden
      states that the motion engine animates from. The failsafe strips it again
      if the engine has not booted in time — a 404, a throw, or JavaScript off
      must never leave content stranded invisible. motion.ts clears the timer.
    */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('js');
        window.__dsMotionFailsafe = setTimeout(function () {
          d.classList.remove('js');
          var p = document.querySelector('[data-preloader]');
          if (p) p.remove();
        }, 2600);

        /*
          The intro's 3D mark, fetched from here rather than from a <link> in
          the markup: it is only wanted on the one visit that plays the intro,
          and the motion engine gives it a fixed budget to arrive before it
          commits to the flat fallback. Starting it during head parse instead
          of after the bundle executes is most of that budget.
        */
        try {
          if (sessionStorage.getItem('ds-intro') === '1') return;
        } catch (e) {
          /* Storage blocked — assume a first visit and preload. */
        }
        // Same test the motion engine applies before it imports three.js at
        // all: on Save-Data or 2G the intro is going to be the flat mark, so
        // fetching the mesh would be a third of a megabyte spent on nothing.
        var c = navigator.connection;
        if (c && (c.saveData || /^(slow-)?2g$/.test(c.effectiveType || ''))) return;
        var l = document.createElement('link');
        l.rel = 'preload';
        l.as = 'fetch';
        l.href = '/brand/ds-mark-3d.glb';
        l.type = 'model/gltf-binary';
        l.crossOrigin = 'anonymous';
        document.head.appendChild(l);
      })();
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    <script>
      import { initMotion } from '../scripts/motion';

      const start = () => {
        try {
          initMotion();
        } catch (err) {
          // Never let a motion failure hide the page.
          clearTimeout(window.__dsMotionFailsafe);
          document.documentElement.classList.remove('js');
          document.querySelector('[data-preloader]')?.remove();
          console.error('[motion]', err);
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
      } else {
        start();
      }
    </script>

    <style>
      .skip-link {
        position: fixed;
        top: 12px;
        left: 12px;
        z-index: 200;
        padding: 10px 16px;
        background: var(--color-bone);
        color: var(--color-ink);
        border-radius: var(--radius-md);
        font-size: 0.875rem;
        font-weight: 500;
        transform: translateY(-200%);
        transition: transform var(--ds-dur) var(--ds-ease);
      }
      .skip-link:focus-visible {
        transform: translateY(0);
      }
    </style>
  </body>
</html>
